# Mẫu cấu hình CHẠY DEMO TRÊN MÁY (profile local, H2).
# CHAY_BACKEND.bat sẽ copy file này thành backend/.env nếu chưa có.
# Không commit backend/.env.

# Tạo dữ liệu mẫu (6 phim, 3 rạp, lịch chiếu 7 ngày) khi database còn trống.
NCT_SEED=true

# Tài khoản quản trị được tạo lần đầu. Mật khẩu 12–72 ký tự.
NCT_ADMIN_EMAIL=admin@nct.local
NCT_ADMIN_PASSWORD=
