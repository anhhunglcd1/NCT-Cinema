# Sao chép thành .env.local nếu cần đổi. Không có giá trị bí mật trong frontend.
# Địa chỉ backend Spring Boot (không thêm /api). Dùng 127.0.0.1 thay vì localhost.
BACKEND_URL=http://127.0.0.1:8080
# Nơi lấy ảnh poster cho đường dẫn /posters/<file> trong dữ liệu mẫu.
POSTER_BASE_URL=https://image.tmdb.org/t/p/w500
